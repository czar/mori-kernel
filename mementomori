#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import sys
import argparse
import random
from datetime import datetime, date

def valid_date(s):
    """Validates the input date format YYYY-MM-DD."""
    try:
        return datetime.strptime(s, "%Y-%m-%d").date()
    except ValueError:
        msg = f"Not a valid date: '{s}'. Please use YYYY-MM-DD."
        raise argparse.ArgumentTypeError(msg)

def print_age_info(agedays, expect, lifetime):
    """Print age and longevity information with clean formatting."""
    print('\n' + '='*30)
    print(f"AGE STATUS:")
    print(f"  You are {agedays / 365.25:,.2f} years old")
    print(f"  You are {agedays / 30.44:,.2f} months old")
    print(f"  You are {agedays / 7.0:,.2f} weeks old")
    print(f"  You are {agedays:,} days old")
    
    print('\nEXPECTED LIFETIME:')
    print(f"  Approx. {expect / 365.25:,.2f} years")
    print(f"  Approx. {expect / 30.44:,.2f} months")
    print(f"  Approx. {expect / 7.0:,.2f} weeks")
    print(f"  Approx. {expect:,.0f} days")
    
    print('\nPROBABILITY:')
    # Calculate percentages safely
    percent_dead = (agedays / lifetime) * 100
    percent_alive = (expect / lifetime) * 100
    print(f"  You are approximately {percent_dead:.1f}% dead")
    print(f"  You are approximately {percent_alive:.1f}% alive")
    print('='*30 + '\n')

def get_lifetime(args):
    """Get lifetime in days based on sex or provided value."""
    # FIX: Check if lifetime is not None before comparing to 0
    if args.lifetime is not None and args.lifetime > 0:
        return args.lifetime * 365.25
    
    # Default UK ONS estimates if no lifetime is provided
    sex = args.sex.upper() if args.sex else None
    if sex == 'M':
        return 79.3 * 365.25
    elif sex == 'F':
        return 82.9 * 365.25
    else:
        # Default to average (approx 81 years) if sex is not provided/recognized
        return 81.1 * 365.25

def main(args):
    try:
        birthday = args.birthdate
        today = date.today()
        
        if birthday > today:
            print(f"ERROR: Birthdate {birthday} cannot be in the future.")
            sys.exit(1)
        if birthday.year < 1900:
            print(f"ERROR: Birthdate {birthday.year} is before the supported range (1900).")
            sys.exit(1)

        age_delta = today - birthday
        agedays = age_delta.days
        lifetime_days = get_lifetime(args)
        expect_days = lifetime_days - agedays

        # Logic for triggering the print (Verbose OR specific intervals OR random chance)
        is_anniversary = (
            agedays % 365 == 0 or      # Yearly anniversary
            agedays % 1825 == 0 or     # 5-year milestone
            agedays % 3652 == 0 or     # 10-year milestone
            random.randint(1, 365) == 365 # Random chance (approx once a year)
        )

        if args.verbose or is_anniversary:
            print_age_info(agedays, expect_days, lifetime_days)
        else:
            # If not an anniversary and not verbose, just show a reminder
            print("Memento Mori... (Run with -v to see details)")

    except Exception as e:
        print(f"An error occurred: {e}")
        sys.exit(1)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Memento mori - Remember death. A tool for life expectancy reflection."
    )
    
    # Required Arguments
    required = parser.add_argument_group('required arguments')
    required.add_argument('-b', '--birthdate',
            help='Date of birth (YYYY-MM-DD)',
            required=True, type=valid_date)

    # Mutually Exclusive Group
    mutex = parser.add_mutually_exclusive_group()
    mutex.add_argument('-s', '--sex',
            help='Sex (m/M for male, f/F for female)',
            type=str, choices=['m', 'M', 'f', 'F'])
    mutex.add_argument('-l', '--lifetime',
            help='Expected lifetime in years (1-100)',
            type=float, metavar='[1-100]')

    # Optional Arguments
    optional = parser.add_argument_group('optional arguments')
    optional.add_argument('-v', '--verbose',
            help='Print detailed information immediately',
            action="store_true")

    args = parser.parse_args()
    main(args)
